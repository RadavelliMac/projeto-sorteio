<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CADASTRAR PARTICIPANTES</title>
    <link rel="stylesheet" href="/assets/CSS/base.css" />
    <link rel="stylesheet" href="/assets/CSS/monthlyRegister.css">
    <link rel="icon" type="image/x-icon" href="/assets/images/imageicon.jpeg">
</head>
<body>
    <div class="cadastro">

        <%- include('common/navbar') %>

        <div class="monthlyRegister">

            <div class="monthlyRegisterInfos">
                <h1>REGISTRO MENSAL</h1>
                <h2>Coloque no campo abaixo apenas o número do dizimista que participará do sorteio desse mês</h2>
            </div>

            <form action="/cadastro-mensal" method="post"> 
                <div class="inputs">
                    <label for="tither">Número do dizimista (ID único): </label>
                    <input type="number" name="titherId" id="titherNumber" required>
                </div>
                <div class="inputs">
                    <input class="submit" type="submit" value="Cadastrar">
                </div>
            </form>
        </div>

        <% if (messages.success && messages.success.length > 0) { %>
            <div class="successMessage">
                <%= messages.success %>
            </div>
        <% } %>

        <% if (messages.error && messages.error.length > 0) { %>
            <div class="errorMessage">
                <% messages.error.forEach(err => { %>
                    <p style="margin: 0;"><%= err %></p>
                <% }) %>
            </div>
        <% } %>

        <div class="VisualizeMonthlyPrizeDrawTithers">
            <h2>Para visualizar os dizimistas que participarão do sorteio esse mês, clique no botão abaixo</h2>

            <a class="visualize" href="/cadastro-mensal/editar">Visualizar Participantes</a>
        </div>

    </div>

        <%- include('common/footer') %>


</body>
</html>