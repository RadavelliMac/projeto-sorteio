<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CADASTRAR DIZIMISTAS</title>
    <link rel="stylesheet" href="/assets/CSS/base.css" />
    <link rel="stylesheet" href="/assets/CSS/register.css">
    <link rel="icon" type="image/x-icon" href="/assets/images/imageicon.jpeg">
</head>
<body>
    
    <%- include('common/navbar') %>
    
    <div class="registerTither">


        <div class="register">

            <div class="form">

                <div class="formInfos">
                    <h1>CADASTRO</h1>
                    <h2>Preencha os campos abaixo corretamente e clique em "<span>Cadastrar</span>"</h2>
                </div>

                <% if (messages.success && messages.success.length > 0) { %>
                    <div class="successMessage">
                        <%= messages.success %>
                    </div>
                <% } %>

                <% if (messages.error && messages.error.length > 0) { %>
                    <div class="errorMessage">
                        <% messages.error.forEach(err => { %>
                            <p style="margin: 0;"><%= err %></p>
                        <% }) %>
                    </div>
                <% } %>

                <form action="" class="formSubmit" method="post">


                    <div class="inputs">
                        <label for="name">Código:  <span class="requiredField">*</span></label>
                        <input type="number" min="0" name="code" placeholder="Ex: 16547" value="" required class="code numberForbidden">
                    </div>

                    <div class="inputs">
                        <label for="name">Nome: <span class="requiredField">*</span></label>
                        <input type="text" name="name" placeholder="Ex: José" value="" required class="name">
                    </div>

                    <div class="inputs">
                        <label for="name">Sobrenome: <span class="requiredField">*</span></label>
                        <input type="text" name="surname" placeholder="Ex: José" value="" required class="surname">
                    </div>

                    <div class="inputs">
                        <label for="neighborhood">Bairro: <span class="requiredField">*</span></label>
                        <input type="text" name="neighborhood" placeholder="Ex: Aventureiro" required class="neighborhood">
                    </div>

                    <div class="inputs">
                        <label for="street">Rua: <span class="requiredField">*</span></label>
                        <input type="text" name="street" placeholder="Ex: Adolfo Morbis" value="" required class="street">
                    </div>

                    <div class="inputs">
                        <label for="number">Número: <span class="requiredField">*</span></label>
                        <input type="number" min="0" name="housenumber" placeholder="Ex: 1111" value="" required class="housenumber numberForbidden">
                    </div>

                    <div class="inputs">
                        <label for="number">Telefone (inclua DDD): <span class="requiredField">*</span></label>
                        <input type="text" name="phone" placeholder="Ex: (88) 9 8888-8888" required class="phone">
                    </div>

                    <div class="inputs">
                        <label for="category">Categoria: <span class="requiredField">*</span></label>
                        <select name="category" id="category" required class="category">
                            <option class="categoryOption" value="Masculino">Masculino</option>
                            <option class="categoryOption" value="Feminino">Feminino</option>
                            <option class="categoryOption" value="Infantil">Infantil</option>
                        </select>
                    </div>

                    <div class="inputs">
                        <input type="submit" value="Cadastrar" class="submit">

                    </div>

                </form>

            </div>

        </div>

        <div class="visualizer">

            <div class="visualizerInfos">
                <h1>VISUALIZAR E EDITAR</h1>
                <h2>Para visualizar, editar ou excluir os dizimistas cadastrados, clique no botão abaixo</h2>
                <a href="/cadastro-geral/editar">Visualizar Dizimistas</a>
            </div>

        </div>

    </div>

        <%- include('common/footer') %>

<script src="/assets/JS/validators/regex.js"></script>
<script src="/assets/JS/validators/titherValidators.js"></script>

</body>
</html>