<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CADASTRAR DIZIMISTAS</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/register.css">
</head>
<body>
    
    <div class="registerTither">

        <%- include('common/navbar') %>

        <div class="register">

            <div class="form">

                <div class="formInfos">
                    <h1>CADASTRO</h1>
                    <h2>Preencha os campos abaixo corretamente e clique em "<span>Cadastrar</span>"</h2>
                </div>

                <form action="" method="post">


                    <div class="inputs">
                        <label for="name">Nome:</label>
                        <input type="text" name="name" placeholder="Ex: José" value="" required>
                    </div>

                    <div class="inputs">
                        <label for="name">Sobrenome:</label>
                        <input type="text" name="surname" placeholder="Ex: José" value="" required>
                    </div>

                    <div class="inputs">
                        <label for="neighborhood">Bairro:</label>
                        <input type="text" name="neighborhood" placeholder="Ex: Aventureiro">
                    </div>

                    <div class="inputs">
                        <label for="street">Rua:</label>
                        <input type="text" name="street" placeholder="Ex: Adolfo Morbis" value="" required>
                    </div>

                    <div class="inputs">
                        <label for="number">Número:</label>
                        <input type="number" min="0" name="housenumber" placeholder="400" value="" required>
                    </div>

                    <div class="inputs">
                        <label for="number">Telefone:</label>
                        <input type="text" name="Telefone" placeholder="4002-8922" >
                    </div>

                    <div class="inputs">
                        <input type="submit" value="Cadastrar" class="submit">
                    </div>

                    <% if (messages.success && messages.success.length > 0) { %>
                        <div class="successMessage">
                            <%= messages.success %>
                        </div>
                    <% } %>

                    <% if (messages.error && messages.error.length > 0) { %>
                        <div class="errorMessage">
                            <% messages.error.forEach(err => { %>
                                <p style="margin: 0;"><%= err %></p>
                            <% }) %>
                        </div>
                    <% } %>

                </form>

            </div>

            <div class="visualizer">

                <div class="visualizerInfos">
                    <h1>VISUALIZAR E EDITAR</h1>
                    <h2>Para visualizar, editar ou excluir os dizimistas cadastrados, clique no botão abaixo</h2>
                    <a href="/cadastro-geral/editar">Visualizar Dizimistas</a>
                </div>

            </div>

        </div>

    </div>



</body>
</html>