<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SORTEIO DIZIMISTAS</title>
    <link rel="stylesheet" href="/assets/CSS/base.css" />
    <link rel="stylesheet" href="/assets/CSS/raffleTither.css">
    <link rel="stylesheet" href="/assets/CSS/visualizer.css">
    <link rel="icon" type="image/x-icon" href="/assets/images/imageicon.jpeg">
</head>
<body>

    <div class="PrizedrawTither">

        <%- include('common/navbar') %>

        <div class="form">

            <form action="/sorteio-dizimista/categoria" method="post">

                <div class="inputs">
                    <label for="category">Categoria:</label>
                    <select name="category" id="category" required>
                        <option class="categoryOption" value="Masculino">Masculino</option>
                        <option class="categoryOption" value="Feminino">Feminino</option>
                        <option class="categoryOption" value="Infantil">Infantil</option>
                    </select>

                    <input type="submit" value="Buscar" class="submit">
                </div>

            </form>

        </div>

        <div class="monthlyRegister">   

            <% if (dizimistas) { %>
            
            <% if (dizimistas.length > 1) { %>

                <table border="1" align="center">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nome</th>
                            <th>Sobrenome</th>
                            <th>Telefone</th>
                            <th>Bairro</th>
                            <th>Rua</th>
                            <th>Número</th>
                            <th>Categoria</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                            <% dizimistas.forEach(dizimista => { %>
                                <tr>
                                    <td> <%= dizimista.dizimista_id %> </td>
                                    <td> <%= dizimista.dizimista_nome %> </td>
                                    <td> <%= dizimista.dizimista_sobrenome %> </td>
                                    <td> <%= dizimista.dizimista_telefone %> </td>
                                    <td> <%= dizimista.dizimista_bairro %> </td>
                                    <td> <%= dizimista.dizimista_rua %> </td>
                                    <td> <%= dizimista.dizimista_numero_casa %> </td>
                                    <td> <%= dizimista.dizimista_categoria %> </td>
                                    <td>
                                        <a href="/cadastro-geral/editar/<%= dizimista.dizimista_id %>">
                                            <img class="image" src="/assets/IMAGES/edit.svg" alt="">
                                        </a>
                                        <a class="delete" data-id="<%= dizimista.dizimista_id %>" href="#">
                                            <img data-id="<%= dizimista.dizimista_id %>" class="image delete" src="/assets/IMAGES/delete.svg" alt="">
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                            
                        </tbody>
                    </table>

                    <% } else { %>

                        <div class="listAllRegisterWarning">
                            <h1>Não há dizimistas suficientes desta categoria para realizar este sorteio</h1>
    
                            <h2 class="registerNewTitherAdvice">Para cadastrar dizimistas ou participantes, selecione um dos botões abaixo:</h2>
                            <a href="/cadastro-geral">Cadastrar Dizimistas</a>
                            <a href="/cadastro-mensal">Cadastrar Participantes</a>
                        </div>

                    <% } %>

                <% } else { %>
                <% } %>

        </div>

    </div>

        <%- include('common/footer') %>


</body>
</html>