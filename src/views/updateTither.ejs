<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/assets/CSS/base.css" />
    <link rel="stylesheet" href="/assets/CSS/register.css">
    <link rel="icon" type="image/x-icon" href="/assets/images/imageicon.jpeg">
    <title>ATUALIZAR CADASTRO DE DIZIMISTA</title>
</head>
<body>

    <%- include('common/navbar') %>

    
    <div class="updateTither">

        <div class="updateInfos">
            <h1>Área para atualizar informações de cadastro de dizimista</h1>

            <% if (dizimistas.length > 0) { %>
                <h2>Para alterar alguma informação, basta corrigir alterando um ou mais campos abaixo:</h2>
            <% } %>

            <% if (messages.error && messages.error.length > 0) { %>
                <div class="errorMessage">
                    <% messages.error.forEach(err => { %>
                        <p style="margin: 0;"><%= err %></p>
                    <% }) %>
                </div>
            <% } %>

        </div>

        <div class="form">
            
            <% if (dizimistas.length > 0) { %>

            <form action="" class="formSubmit" method="post">

                <% dizimistas.forEach(dizimista => { %>

                <div class="inputs">
                    <label for="name">Código: <span class="requiredField">*</span> </label>
                    <input type="number" min="0" name="code" placeholder="Ex: 16547" value="<%= dizimista.dizimista_id %>" required class="code numberForbidden">
                </div>

                <div class="inputs">
                    <label for="name">Nome: <span class="requiredField">*</span> </label>
                    <input type="text" name="name" placeholder="Ex: José" value="<%= dizimista.dizimista_nome %>" required class="name">
                </div>
    
                <div class="inputs">
                    <label for="name">Sobrenome: <span class="requiredField">*</span> </label>
                    <input type="text" name="surname" placeholder="Ex: José" value="<%= dizimista.dizimista_sobrenome %>" required class="surname">
                </div>
    
                <div class="inputs">
                    <label for="neighborhood">Bairro: <span class="requiredField">*</span> </label>
                    <input type="text" name="neighborhood" placeholder="Ex: Aventureiro" value="<%= dizimista.dizimista_bairro %>" required class="neighborhood">
                </div>
    
                <div class="inputs">
                    <label for="street">Rua: <span class="requiredField">*</span> </label>
                    <input type="text" name="street" placeholder="Ex: Adolfo Morbis" value="<%= dizimista.dizimista_rua %>" required class="street">
                </div>
    
                <div class="inputs">
                    <label for="number">Número: <span class="requiredField">*</span> </label>
                    <input type="number" min="0" name="housenumber" placeholder="Ex: 1111" value="<%= dizimista.dizimista_numero_casa %>" required class="housenumber numberForbidden">
                </div>
    
                <div class="inputs">
                    <label for="number">Telefone: <span class="requiredField">*</span> </label>
                    <input type="text" name="phone" placeholder="Ex: (88) 9 8888-8888" value="<%= dizimista.dizimista_telefone %>" class="phone">
                </div>

                <div class="inputs">
                    <label for="category">Categoria: <span class="requiredField">*</span> </label>
                    <select name="category" id="category" required class="category">
                        <option value="Masculino" <%= dizimista.dizimista_categoria === 'Masculino' ? 'selected' : '' %>>Masculino</option>
                        <option value="Feminino" <%= dizimista.dizimista_categoria === 'Feminino' ? 'selected' : '' %>>Feminino</option>
                        <option value="Infantil" <%= dizimista.dizimista_categoria === 'Infantil' ? 'selected' : '' %>>Infantil</option>
                    </select>
                </div>
    
                <div class="inputs">
                    <input type="submit" value="Cadastrar" class="submit">
                </div>


                <% }) %>

                
    
            </form>

                <% } else { %>

                    <div class="ListTitherRequiredWarning">
                        <h1>Nenhum dizimista informado</h1>

                        <h2 class="registerNewTitherAdvice">
                            Nenhum dizimista foi encontrado. 
                            Verifique o ID correto ou clique no botão abaixo para cadastrar um dizimista:
                        </h2>
                        <a href="/cadastro-geral">Cadastrar Dizimistas</a>
                    </div>

                <% } %>

        </div>

    </div>

        <%- include('common/footer') %>

<script src="/assets/JS/validators/regex.js"></script>
<script src="/assets/JS/validators/fieldValidators.js"></script>

</body>
</html>