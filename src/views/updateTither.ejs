<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=[device-width], initial-scale=1.0">
    <link rel="stylesheet" href="/assets/CSS/style.css">
    <link rel="stylesheet" href="/assets/CSS/register.css">
    <title>ATUALIZAR CADASTRO DE DIZIMISTA</title>
</head>
<body>

    <%- include('common/navbar') %>

    
    <div class="updateTither">

        <div class="updateInfos">
            <h1>Área para atualizar informações de cadastro de dizimista</h1>

            <% if (dizimistas.length > 0) { %>
                <h2>Para alterar alguma informação, basta corrigir alterando um ou mais campos abaixo:</h2>
            <% } %>

        </div>

        <div class="form">
            
            <% if (dizimistas.length > 0) { %>

            <form action="" method="post">

                <% dizimistas.forEach(dizimista => { %>

                <div class="inputs">
                    <label for="name">Nome:</label>
                    <input type="text" name="name" placeholder="Ex: José" value="<%= dizimista.dizimista_nome %>" required>
                </div>
    
                <div class="inputs">
                    <label for="name">Sobrenome:</label>
                    <input type="text" name="surname" placeholder="Ex: José" value="<%= dizimista.dizimista_sobrenome %>" required>
                </div>
    
                <div class="inputs">
                    <label for="neighborhood">Bairro:</label>
                    <input type="text" name="neighborhood" placeholder="Ex: Aventureiro" value="<%= dizimista.dizimista_bairro %>" required>
                </div>
    
                <div class="inputs">
                    <label for="street">Rua:</label>
                    <input type="text" name="street" placeholder="Ex: Adolfo Morbis" value=<%= dizimista.dizimista_rua %> required>
                </div>
    
                <div class="inputs">
                    <label for="number">Número:</label>
                    <input type="number" min="0" name="housenumber" placeholder="400" value="<%= dizimista.dizimista_numero_casa %>" required>
                </div>
    
                <div class="inputs">
                    <label for="number">Telefone:</label>
                    <input type="text" name="Telefone" placeholder="4002-8922" value="<%= dizimista.dizimista_telefone %>">
                </div>
    
                <div class="inputs">
                    <input type="submit" value="Cadastrar" class="submit">
                </div>

                <% if (messages.error && messages.error.length > 0) { %>
                    <div class="errorMessage">
                        <% messages.error.forEach(err => { %>
                            <p style="margin: 0;"><%= err %></p>
                        <% }) %>
                    </div>
                <% } %>


                <% }) %>

                
    
            </form>

                    <% } else { %>

                        <div class="ListTitherRequiredWarning">
                            <h1>Nenhum dizimista informado</h1>
    
                            <h2 class="registerNewTitherAdvice">
                                Nenhum dizimista foi encontrado. 
                                Verifique o ID correto ou clique no botão abaixo para cadastrar um dizimista:
                            </h2>
                            <a href="/cadastro-geral">Cadastrar Dizimistas</a>
                        </div>

                    <% } %>

        </div>

    </div>



</body>
</html>